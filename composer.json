{
  "name": "anibalealvarezs/mailchimp-hub-driver",
  "description": "APIs-Hub driver for Mailchimp marketing & eCommerce integration.",
  "license": "MIT",
  "authors": [
    {
      "name": "Aníbal Álvarez",
      "email": "anibalealvarezs@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "anibalealvarezs/api-client-skeleton": "^1.0.0",
    "anibalealvarezs/api-driver-core": "^1.1.2",
    "anibalealvarezs/mailchimp-api": "1.0.0",
    "symfony/http-foundation": "^6.0 || ^7.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "nesbot/carbon": "^2.0 || ^3.0",
    "doctrine/orm": "^2.12.3 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "Anibalealvarezs\\MailchimpHubDriver\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "require-dev": {
    "doctrine/instantiator": "^1.5",
    "phpunit/phpunit": "^9.6.20"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://satis.anibalalvarez.com/"
    }
  ]
}
